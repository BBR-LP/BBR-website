# Photo review page: sign in with GitHub. Copy to .env (never commit it) and fill in.
# Local try-out without GitHub: REVIEW_MODE=local and REVIEW_DATA_DIR=<folder made by photo-tools review-prep>.

REVIEW_MODE=github

# The GitHub App "BBR-LP Photo Review" (Contents: read and write, installed only on BBR-photo-data).
# Client ID and a client secret come from the app's settings page; keep both in Proton Pass.
REVIEW_GITHUB_CLIENT_ID=
REVIEW_GITHUB_CLIENT_SECRET=

# 32+ random characters; encrypts the sign-in cookie. e.g. `openssl rand -base64 36`
REVIEW_SESSION_SECRET=

# Where this page is served from, with no trailing slash. GitHub sends people back to <this>/api/auth/callback,
# and that exact address must be in the GitHub App's callback URLs.
REVIEW_BASE_URL=http://127.0.0.1:3400

# The private repo that holds batches and decisions.
REVIEW_DATA_REPO=BBR-LP/BBR-photo-data

# Testing only: point at tools/mock-github.mjs instead of the real GitHub.
# GITHUB_WEB_URL=http://127.0.0.1:3499
# GITHUB_API_URL=http://127.0.0.1:3499

# Photos from the business Dropbox (a read-only app: files.metadata.read + files.content.read, "Full Dropbox" access).
# App key and secret from the app's Settings page; the refresh token from `node --env-file=.env tools/dropbox-token.mjs`.
# Without these the hosted page shows "Photo not connected yet" instead of pictures. All three go in Proton Pass.
REVIEW_DROPBOX_APP_KEY=
REVIEW_DROPBOX_APP_SECRET=
REVIEW_DROPBOX_REFRESH_TOKEN=
# Testing only: point at tools/mock-dropbox.mjs.
# DROPBOX_API_URL=http://127.0.0.1:3498
# DROPBOX_CONTENT_URL=http://127.0.0.1:3498
